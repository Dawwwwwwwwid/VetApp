---
---
<layout>
    <div class="findSpecialistsPage">
        <div class="SpecialistFinderBox">
            <div class="SearchBar">
                <input type="text" placeholder="Search..." />
                <button>Filter </button>
            </div>
            
            <div class="SpecialistBox">
                <img src="/images/vet.png" alt="Vet" width="100" height="100">
                <div class="SpecialistInfo">
                    <h3>Dr. Smith</h3>
                    <p>Specialty: Cats and Dogs</p>
                    <button>View Profile</button>
                </div>
            </div>

            <div class="SpecialistBox">
                <img src="/images/man.png" alt="Chad" width="100" height="100">
                <div class="SpecialistInfo">
                    <h3>Chas Johnson</h3>
                    <p>Specialty: Arachnids</p>
                    <button>View Profile</button>
                </div>
            </div>
        </div>
    </div>
</layout>

<style>

    .findSpecialistsPage {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #6e6e6e;
    }

    .searchBar {
        display: flex;
        justify-content: row;
        align-items: space-between;
        margin-bottom: 20px;
    }

    .specialistFinderBox {
        display: flex;
        justify-content: column;
        align-items: center;
        height: 100vh;
        background-color: #6e6e6e;
    }

    .SpecialistBox{
        display: flex;
		flex-direction: row;
		justify-content: space-between;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 10px;
        width: 300px;
        
    }

    .SpecialistInfo {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 10px;
    }
</style>