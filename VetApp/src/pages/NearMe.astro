---

---
<layout>
    <div class="findNearbyPage">
        <div class="FinderBox">
            <div class="SearchBar">
                <input type="text" placeholder="your address..." />
                <button>Filter</button>
            </div>

            <div class="map"></div>
        </div>
    </div>
</layout>

<style>
    .findNearbyPage {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #6e6e6e;
        box-sizing: border-box;
        padding: 32px 24px;
    }

    .FinderBox {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        width: min(100%, 1100px);
    }

    .SearchBar {
        display: flex;
        gap: 12px;
        width: 100%;
    }

    .SearchBar input {
        flex: 1;
        min-width: 0;
        padding: 12px 16px;
        border: 0;
        border-radius: 6px;
        font: inherit;
    }

    .SearchBar button {
        padding: 12px 20px;
        border: 0;
        border-radius: 6px;
        cursor: pointer;
    }

    .map {
        width: 100%;
        height: min(68vh, 680px);
        min-height: 360px;
        background-color: #494949;
        border-radius: 8px;
    }

    @media (max-width: 600px) {
        .findNearbyPage {
            padding: 24px 16px;
        }

        .map {
            height: 60vh;
            min-height: 280px;
        }
    }
</style>